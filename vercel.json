{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), camera=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "heyelsie.com"
        }
      ],
      "destination": "/welcome"
    },
    {
      "source": "/r/:token",
      "destination": "/api/reviews/click?token=:token"
    },
    {
      "source": "/scriptcall1",
      "destination": "/api/script-call"
    },
    {
      "source": "/scripcall1",
      "destination": "/api/script-call"
    },
    {
      "source": "/report",
      "destination": "/api/report"
    },
    {
      "source": "/timesheet",
      "destination": "/api/timesheet"
    },
    {
      "source": "/s/:slug([a-z0-9][a-z0-9-]*)/:p1([a-z0-9-]+)/:p2([a-z0-9-]+)",
      "destination": "/api/site-demo/page?slug=:slug&p1=:p1&p2=:p2"
    },
    {
      "source": "/s/:slug([a-z0-9][a-z0-9-]*)/:p1([a-z0-9-]+)",
      "destination": "/api/site-demo/page?slug=:slug&p1=:p1"
    },
    {
      "source": "/s/:slug([a-z0-9][a-z0-9-]*$)",
      "has": [
        {
          "type": "host",
          "value": "heyelsie.com"
        }
      ],
      "destination": "/api/site-demo/page?slug=:slug"
    },
    {
      "source": "/:slug((?!api$|assets$|r$|s$|report$|timesheet$|welcome$|subscribe$|onboarding$|login$|continue$|join$|integrations$|admin$|super$|favicon$|robots$|sitemap$|index$|pricing$|terms$|privacy$|dpa$|blog$|register$|forgot-password$|reset-password$|script$|scriptcall1$|scripcall1$|blueprint$|pedro-training$|hugo-training$|rank-frame$|leads$|calls$|appointments$|conversations$|quotes$|invoices$|contacts$|settings$)[a-z0-9][a-z0-9-]*$)",
      "has": [
        {
          "type": "host",
          "value": "heyelsie.com"
        }
      ],
      "destination": "/api/vsl/page?slug=:slug"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/cron/daily-agent-reports.ts": {
      "maxDuration": 300,
      "includeFiles": "src/core/content/property-call-script.html"
    },
    "api/cron/review-requests.ts": {
      "maxDuration": 60
    },
    "api/reviews/send-test.ts": {
      "maxDuration": 30
    },
    "api/cron/social-posts.ts": {
      "maxDuration": 60
    },
    "api/reviews/social/publish.ts": {
      "maxDuration": 30
    },
    "api/script-call.ts": {
      "includeFiles": "src/core/content/property-call-script.html"
    },
    "api/crm/fetch-ballpark.ts": {
      "maxDuration": 60
    },
    "api/cron/ballpark-runner.ts": {
      "maxDuration": 300
    },
    "api/cron/call-listener.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/messages/poll",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/messages/process-takeovers",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/contacts/sync-avatars",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/billing/create-invoice",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/notifications/daily-summary",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/calendar-health",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/inactive-accounts",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/sync-prompts",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/schedule-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/send-notifications",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/agent/tick",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/crm-jobs-pump",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/price-feedback-weekly",
      "schedule": "30 8 * * 1"
    },
    {
      "path": "/api/cron/daily-agent-reports",
      "schedule": "30 16 * * *"
    },
    {
      "path": "/api/cron/notify-drain",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/deal-sweep",
      "schedule": "*/2 6-20 * * *"
    },
    {
      "path": "/api/cron/ballpark-runner",
      "schedule": "*/5 6-20 * * *"
    },
    {
      "path": "/api/cron/builder-outreach",
      "schedule": "*/5 6-20 * * *"
    },
    {
      "path": "/api/cron/builder-morning",
      "schedule": "0 7,8 * * *"
    },
    {
      "path": "/api/cron/call-listener",
      "schedule": "*/5 6-21 * * *"
    },
    {
      "path": "/api/cron/heypubli-pipeline-sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/heypubli-deadman",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/system-deadman",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/transcribe-calls",
      "schedule": "*/5 * * * *"
    }
  ]
}
