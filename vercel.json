{
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "heyelsie.com" }],
      "destination": "/welcome"
    },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/messages/poll",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/messages/process-takeovers",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/follow-up/enqueue",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/follow-up",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/contacts/sync-avatars",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/billing/create-invoice",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/notifications/daily-summary",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/calendar-health",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/inactive-accounts",
      "schedule": "0 3 * * *"
    }
  ]
}
