{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/messages/poll",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/follow-up",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/contacts/sync-avatars",
      "schedule": "30 * * * *"
    }
  ]
}
